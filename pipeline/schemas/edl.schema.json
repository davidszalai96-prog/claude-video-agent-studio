{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-video-agent-studio.local/schemas/edl.schema.json",
  "title": "Editor-neutral EDL",
  "description": "A cut version written by the Editor (07_edit/edl_v###.json) and conformed by Finishing through the editor adapter. Record frames are relative to the timeline start; source frames are in the source file (in inclusive, out exclusive).",
  "type": "object",
  "required": ["version", "project", "created", "timeline", "tracks"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^edl_v\\d{3}$" },
    "project": { "$ref": "common.schema.json#/$defs/project_code" },
    "created": { "$ref": "common.schema.json#/$defs/timestamp" },
    "locked": { "type": "boolean", "description": "True from picture lock (G3)." },
    "timeline": {
      "type": "object",
      "required": ["fps", "width", "height", "duration_frames"],
      "additionalProperties": false,
      "properties": {
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "start_timecode": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}:\\d{2}$" }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "clips"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["video", "audio"] },
          "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } }
        }
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "name"],
        "additionalProperties": false,
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "color": { "type": "string" },
          "note": { "type": "string" },
          "temporary": { "type": "boolean" }
        }
      }
    },
    "changelog": { "$ref": "common.schema.json#/$defs/project_path" }
  },
  "$defs": {
    "keyframe": {
      "type": "object",
      "required": ["frame", "value"],
      "additionalProperties": false,
      "properties": { "frame": { "type": "integer", "description": "Clip-relative record frame; negative covers a transition's pre-roll." }, "value": { "type": "number" } }
    },
    "clip": {
      "type": "object",
      "required": ["clip_id", "source", "record"],
      "additionalProperties": false,
      "properties": {
        "clip_id": { "type": "string" },
        "select": { "$ref": "common.schema.json#/$defs/select_id" },
        "placeholder": { "type": "boolean", "description": "An animatic keyframe standing in for missing footage." },
        "source": {
          "type": "object",
          "required": ["file", "frames"],
          "additionalProperties": false,
          "properties": {
            "file": { "$ref": "common.schema.json#/$defs/abs_path" },
            "frames": { "$ref": "common.schema.json#/$defs/frame_range" },
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        },
        "record": { "$ref": "common.schema.json#/$defs/frame_range" },
        "speed": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["fill_crop", "fit", "custom"] },
            "scale": { "type": "number", "exclusiveMinimum": 0 },
            "position": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "additionalProperties": false },
            "crop": { "type": "object", "properties": { "left": { "type": "number" }, "top": { "type": "number" }, "right": { "type": "number" }, "bottom": { "type": "number" } }, "additionalProperties": false },
            "upscale_factor": { "type": "number", "exclusiveMinimum": 0 },
            "upscale_flag": { "type": "boolean", "description": "True above ~1.5x." }
          }
        },
        "transition_in": {
          "type": "object",
          "required": ["type", "frames"],
          "additionalProperties": false,
          "properties": { "type": { "enum": ["dissolve", "dip_to_black", "dip_to_white"] }, "frames": { "type": "integer", "minimum": 1 } }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["zoom", "opacity", "flash", "impact_inversion", "chromatic_aberration", "glow", "title", "other"] },
              "keyframes": { "type": "array", "items": { "$ref": "#/$defs/keyframe" } },
              "params": { "type": "object" },
              "post_fx_ref": { "type": "string" }
            }
          }
        },
        "gain_db": { "type": "number" },
        "notes": { "type": "string" }
      }
    }
  }
}
